      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - max by (loop) (greenkube_loop_last_success_timestamp_seconds{namespace=~\"$namespace\"} > 0)",
          "legendFormat": "{{loop}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 11,
      "title": "Time since last successful scan (all clusters)",
      "description": "Last fully successful recommendation scan. Controller series carry no cluster label: this panel ignores the Cluster variable and shows every GreenKube controller in the selected namespaces.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 4,
        "h": 7
