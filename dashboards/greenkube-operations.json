          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "id": 16,
      "title": "Ledger chain (all clusters)",
      "description": "Last hash-chain verification of the savings ledger, per cluster uid. Controller series carry no cluster label: this panel ignores the Cluster variable and shows every GreenKube controller in the selected namespaces.",
