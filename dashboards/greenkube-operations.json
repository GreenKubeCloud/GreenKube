        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Recommendation scans (1h) (all clusters)",
      "description": "Completed optimization runs by status. Controller series carry no cluster label: this panel ignores the Cluster variable and shows every GreenKube controller in the selected namespaces.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 4,
        "y": 21,
        "w": 10,
        "h": 7
      },
