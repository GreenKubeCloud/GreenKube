          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - max(greenkube_last_successful_optimization_run_timestamp_seconds{namespace=~\"$namespace\"} > 0)",
          "legendFormat": "age"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
