    {
      "type": "timeseries",
      "id": 13,
      "title": "Recommendation source failures (1h) (all clusters)",
      "description": "Failures by recommendation source; a run with some failed sources still succeeds. Controller series carry no cluster label: this panel ignores the Cluster variable and shows every GreenKube controller in the selected namespaces.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
