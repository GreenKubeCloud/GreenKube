    {
      "type": "timeseries",
      "id": 21,
      "title": "Net cost savings accrued, by method",
      "description": "Attributed minus reversed. Every API replica serves the same database-backed counters, so each series is deduplicated with max before the sum. Never add methods: only measured is realized.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
